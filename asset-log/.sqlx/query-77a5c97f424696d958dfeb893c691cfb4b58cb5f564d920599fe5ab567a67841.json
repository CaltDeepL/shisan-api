{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.asset_id, p.priced_on, p.price, p.source, p.updated_at\n        FROM asset_prices p\n        JOIN assets a ON a.id = p.asset_id\n        WHERE p.asset_id = $1\n          AND a.user_id  = $2\n          AND ($3::date IS NULL OR p.priced_on >= $3)\n          AND ($4::date IS NULL OR p.priced_on <= $4)\n        ORDER BY p.priced_on DESC\n        ",
