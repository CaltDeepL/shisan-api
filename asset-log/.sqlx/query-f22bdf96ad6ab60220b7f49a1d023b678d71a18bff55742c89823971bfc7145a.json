{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            user_id,\n            symbol,\n            name,\n            asset_class AS \"asset_class: AssetClass\",\n            currency,\n            price_unit,\n            created_at,\n            updated_at\n        FROM assets\n        WHERE user_id = $1\n          AND (\n                $2::text IS NULL\n             OR symbol ILIKE '%' || $2 || '%'\n             OR name   ILIKE '%' || $2 || '%'\n          )\n        ORDER BY upper(symbol)\n        ",
