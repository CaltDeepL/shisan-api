  "query": "\n        SELECT\n            id, user_id, symbol, name,\n            asset_class AS \"asset_class: AssetClass\",\n            currency, price_unit, created_at, updated_at\n        FROM assets\n        WHERE user_id = $1 AND upper(symbol) = upper($2)\n        ",
