{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT ON (p.asset_id)\n            p.asset_id  AS \"asset_id!\",\n            p.price     AS \"price!\",\n            p.priced_on AS \"priced_on!\"\n        FROM asset_prices p\n        JOIN assets s ON s.id = p.asset_id\n        WHERE s.user_id = $1\n        ORDER BY p.asset_id, p.priced_on DESC\n        ",
