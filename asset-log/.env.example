# sqlx CLI / `cargo test` などホスト側から直接実行するときに使う接続情報。
# ユーザー・パスワード・DB名はリポジトリ直下の .env（Compose 用）と揃えてください。
# ホスト名は Compose のサービス名ではなく localhost です。
DATABASE_URL=postgres://assetlog:assetlog_dev_password@localhost:5432/assetlog

PORT=8080
RUST_LOG=asset_log=debug,tower_http=debug

# JWT署名鍵。32バイト以上必須（未満だと起動時にエラーで落ちます）。
# 以下のコマンドで生成した値に置き換えてください
#   openssl rand -base64 32
JWT_SECRET=change_me
JWT_TTL_MINUTES=60

FX_API_BASE_URL=https://api.frankfurter.dev/v1
FX_TIMEOUT_MS=3000
FX_MAX_CALENDAR_DAYS=4
FX_MAX_BUSINESS_DAYS=2

# 日次スナップショットバッチ（POST /snapshots/run）用トークン。
# 空のままなら該当エンドポイントは503で無効化されます（ローカル動作には不要）
# 設定する場合は32バイト以上にしてください
SNAPSHOT_JOB_TOKEN=
