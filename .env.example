# Postgres（db コンテナの初期化に使われます）
POSTGRES_USER=assetlog
POSTGRES_PASSWORD=assetlog_dev_password
POSTGRES_DB=assetlog

# api コンテナ
PORT=8080
RUST_LOG=asset_log=debug,tower_http=debug

# JWT署名鍵。32バイト以上必須（未満だと起動時にエラーで落ちます）。
# 以下のコマンドで生成した値に置き換えてください
#   openssl rand -base64 32
JWT_SECRET=change_me

# 日次スナップショットバッチ（POST /snapshots/run）用トークン。
# 空のままなら該当エンドポイントは503で無効化されます（ローカル動作には不要）
# 設定する場合は32バイト以上にしてください
SNAPSHOT_JOB_TOKEN=

# pgAdmin ログイン情報
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
